# Supabase — get from your project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ──────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Webhook secret — from Stripe dashboard → Webhooks → your endpoint
# For local dev: stripe listen --forward-to localhost:3000/api/stripe/webhooks
STRIPE_WEBHOOK_SECRET=whsec_

# Your price IDs from Stripe dashboard → Products
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=price_

# ── Stripe Connect (set by Vibe Launchpad when provisioned via platform) ────
# Leave blank if running standalone with your own Stripe account
STRIPE_CONNECT_ACCOUNT_ID=
STRIPE_PLATFORM_FEE_PERCENT=

# ── App URL (used for redirect URLs) ────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── FinanceOps (Hermes) integration — Phase 1 prep, DISABLED by default ────────
# NAMES ONLY. Never commit values. Server-side only; Hermes never receives the
# service-role key, a database password, or any staff/Owner login — only the
# endpoint URL and the active HMAC secret (rotated by Claire / an authorised admin).
FINANCEOPS_INTAKE_ENABLED=false
# Comma-separated subset of: IEA,IETA,PLC,KALER (empty = nothing allowed). Ceiling for the whole integration.
FINANCEOPS_ALLOWED_ENTITY_CODES=
# Optional per-key narrowing (subset of the ceiling; unset = the ceiling)
FINANCEOPS_ALLOWED_ENTITY_CODES_CURRENT=
FINANCEOPS_ALLOWED_ENTITY_CODES_NEXT=
# Best-effort per-key rate limit per warm serverless instance (1-600, default 30)
FINANCEOPS_RATE_LIMIT_PER_MINUTE=
# Request timestamp tolerance in seconds (30-900, default 300)
FINANCEOPS_MAX_SKEW_SECONDS=
FINANCEOPS_HMAC_KEY_ID_CURRENT=
FINANCEOPS_HMAC_SECRET_CURRENT=
FINANCEOPS_HMAC_KEY_ID_NEXT=
FINANCEOPS_HMAC_SECRET_NEXT=
# Dedicated Supabase Auth user (existing data_entry role) used by the Hub server-side so RLS applies.
# NOT used yet: needs the future intake migration and a separately approved Production account window.
FINANCEOPS_DB_USER_EMAIL=
FINANCEOPS_DB_USER_PASSWORD=
